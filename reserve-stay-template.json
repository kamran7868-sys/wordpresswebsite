{
  "version": "0.4",
  "title": "PGE Reserve Stay (Hotel Detail) Template",
  "type": "page",
  "page_settings": {},
  "content": [
    {
      "id": "stay_hero_sec",
      "elType": "container",
      "isInner": false,
      "settings": {
        "_css_classes": "stay-hero-section",
        "container_type": "flex",
        "content_width": "full"
      },
      "elements": [
        {
          "id": "stay_hero_box",
          "elType": "container",
          "isInner": true,
          "settings": {
            "_css_classes": "container"
          },
          "elements": [
            {
              "id": "stay_tagline",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "_css_classes": "section-tagline",
                "title": "Canada — Banff National Park Luxury Castle",
                "header_size": "h5"
              }
            },
            {
              "id": "stay_title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "_css_classes": "section-title",
                "title": "Fairmont Banff Springs Castle & Spa",
                "header_size": "h1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "stay_suites_sec",
      "elType": "container",
      "isInner": false,
      "settings": {
        "_css_classes": "section",
        "container_type": "flex",
        "content_width": "full"
      },
      "elements": [
        {
          "id": "suites_grid_box",
          "elType": "container",
          "isInner": true,
          "settings": {
            "_css_classes": "container suites-grid"
          },
          "elements": [
            {
              "id": "suite_card_1",
              "elType": "container",
              "isInner": true,
              "settings": {
                "_css_classes": "suite-card"
              },
              "elements": [
                {
                  "id": "suite_img",
                  "elType": "widget",
                  "widgetType": "image",
                  "settings": {
                    "image": {
                      "url": "https://images.unsplash.com/photo-1566073771259-6a8506099945?q=80&w=800&auto=format&fit=crop",
                      "alt": "Royal Alpine Suite"
                    }
                  }
                },
                {
                  "id": "suite_title",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "_css_classes": "suite-title",
                    "title": "Royal Alpine Penthouse Suite",
                    "header_size": "h3"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
