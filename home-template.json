{
  "version": "0.4",
  "title": "PGE Home Page Template",
  "type": "page",
  "page_settings": {},
  "content": [
    {
      "id": "home_hero_sec",
      "elType": "container",
      "isInner": false,
      "settings": {
        "_css_classes": "hero-slider-section",
        "container_type": "flex",
        "content_width": "full",
        "background_background": "classic"
      },
      "elements": [
        {
          "id": "hero_content_box",
          "elType": "container",
          "isInner": true,
          "settings": {
            "_css_classes": "container hero-content",
            "flex_direction": "column"
          },
          "elements": [
            {
              "id": "hero_tagline_w",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "_css_classes": "hero-tagline",
                "title": "Where Dreams Become A Reality",
                "header_size": "h4"
              }
            },
            {
              "id": "hero_title_w",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "_css_classes": "hero-title",
                "title": "Extraordinary Journeys, Curated for You",
                "header_size": "h1"
              }
            },
            {
              "id": "hero_desc_w",
              "elType": "widget",
              "widgetType": "text-editor",
              "settings": {
                "_css_classes": "hero-desc",
                "editor": "<p>Discover bespoke international holidays, ocean cruises, luxury 5-star resorts, and seamless flight bookings backed by Canadian travel expertise.</p>"
              }
            },
            {
              "id": "hero_btn_w",
              "elType": "widget",
              "widgetType": "button",
              "settings": {
                "_css_classes": "btn-primary",
                "text": "Plan Your Journey Today!",
                "link": {
                  "url": "#cta-section"
                }
              }
            }
          ]
        }
      ]
    },
    {
      "id": "home_intro_sec",
      "elType": "container",
      "isInner": false,
      "settings": {
        "_css_classes": "intro-section",
        "container_type": "flex",
        "content_width": "full"
      },
      "elements": [
        {
          "id": "intro_inner_box",
          "elType": "container",
          "isInner": true,
          "settings": {
            "_css_classes": "container intro-grid",
            "flex_direction": "row"
          },
          "elements": [
            {
              "id": "intro_content_box",
              "elType": "container",
              "isInner": true,
              "settings": {
                "_css_classes": "intro-content"
              },
              "elements": [
                {
                  "id": "intro_tagline",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "_css_classes": "section-tagline",
                    "title": "Your Canadian Gateway to the World",
                    "header_size": "h5"
                  }
                },
                {
                  "id": "intro_title",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "_css_classes": "section-title",
                    "title": "Your Journey Begins Here",
                    "header_size": "h2"
                  }
                },
                {
                  "id": "intro_desc",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "_css_classes": "intro-paragraph",
                    "editor": "<p>Premium Global Expeditions is a Canadian based global travel company creating exceptional journeys across the world.</p>"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
