{
  "version": "0.4",
  "title": "PGE View Voyage (Cruise Detail) Template",
  "type": "page",
  "page_settings": {},
  "content": [
    {
      "id": "voyage_hero_sec",
      "elType": "container",
      "isInner": false,
      "settings": {
        "_css_classes": "voyage-hero-section",
        "container_type": "flex",
        "content_width": "full"
      },
      "elements": [
        {
          "id": "voyage_hero_box",
          "elType": "container",
          "isInner": true,
          "settings": {
            "_css_classes": "container"
          },
          "elements": [
            {
              "id": "voyage_tagline",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "_css_classes": "section-tagline",
                "title": "Alaskan Ocean Expedition — Fjord Glaciers & Wildlife",
                "header_size": "h5"
              }
            },
            {
              "id": "voyage_title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "_css_classes": "section-title",
                "title": "Inside Passage Glacier Voyage",
                "header_size": "h1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "voyage_cabins_sec",
      "elType": "container",
      "isInner": false,
      "settings": {
        "_css_classes": "section",
        "container_type": "flex",
        "content_width": "full"
      },
      "elements": [
        {
          "id": "cabins_grid_box",
          "elType": "container",
          "isInner": true,
          "settings": {
            "_css_classes": "container cabin-suites-grid"
          },
          "elements": [
            {
              "id": "cabin_stateroom",
              "elType": "container",
              "isInner": true,
              "settings": {
                "_css_classes": "cabin-card"
              },
              "elements": [
                {
                  "id": "cabin_img",
                  "elType": "widget",
                  "widgetType": "image",
                  "settings": {
                    "image": {
                      "url": "https://images.unsplash.com/photo-1548574505-5e239809ee19?q=80&w=800&auto=format&fit=crop",
                      "alt": "Luxury Oceanview Stateroom"
                    }
                  }
                },
                {
                  "id": "cabin_title",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "_css_classes": "cabin-title",
                    "title": "Verandah Oceanview Suite",
                    "header_size": "h3"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
