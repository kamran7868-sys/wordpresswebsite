{
  "version": "0.4",
  "title": "PGE Contact Us Page Template",
  "type": "page",
  "page_settings": {},
  "content": [
    {
      "id": "contact_hero_sec",
      "elType": "container",
      "isInner": false,
      "settings": {
        "_css_classes": "contact-hero-section",
        "container_type": "flex",
        "content_width": "full"
      },
      "elements": [
        {
          "id": "contact_hero_box",
          "elType": "container",
          "isInner": true,
          "settings": {
            "_css_classes": "container"
          },
          "elements": [
            {
              "id": "contact_tagline",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "_css_classes": "section-tagline",
                "title": "Connect With PGE Canadian Specialists",
                "header_size": "h5"
              }
            },
            {
              "id": "contact_title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "_css_classes": "section-title",
                "title": "Get In Touch With Us",
                "header_size": "h1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "offices_sec",
      "elType": "container",
      "isInner": false,
      "settings": {
        "_css_classes": "section",
        "container_type": "flex",
        "content_width": "full"
      },
      "elements": [
        {
          "id": "offices_grid_box",
          "elType": "container",
          "isInner": true,
          "settings": {
            "_css_classes": "container offices-grid"
          },
          "elements": [
            {
              "id": "office_toronto",
              "elType": "container",
              "isInner": true,
              "settings": {
                "_css_classes": "office-card"
              },
              "elements": [
                {
                  "id": "office_1_title",
                  "elType": "widget",
                  "widgetType": "heading",
                  "settings": {
                    "_css_classes": "office-city",
                    "title": "Toronto, ON — Headquarters",
                    "header_size": "h3"
                  }
                },
                {
                  "id": "office_1_desc",
                  "elType": "widget",
                  "widgetType": "text-editor",
                  "settings": {
                    "_css_classes": "office-detail",
                    "editor": "<p>100 King Street West, Suite 5600<br>Toronto, ON M5X 1C9, Canada<br>Email: concierge@pgeexpeditions.ca</p>"
                  }
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
