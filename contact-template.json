{
  "version": "0.4",
  "title": "PGE Contact Page - Get In Touch",
  "type": "page",
  "content": [
    {
      "id": "utility-bar-container",
      "elType": "container",
      "isInner": false,
      "settings": {
        "background_background": "classic",
        "background_color": "#252E47",
        "padding": { "unit": "px", "top": "10", "right": "0", "bottom": "10", "left": "0" }
      },
      "elements": [
        {
          "id": "utility-links-widget",
          "elType": "widget",
          "widgetType": "html",
          "settings": {
            "html": "<div class=\"utility-links\">Flights | Hotels | Cruises | Packages | Tours & Experiences | Car Rentals</div>"
          }
        }
      ]
    },
    {
      "id": "contact-hero-container",
      "elType": "container",
      "isInner": false,
      "settings": {
        "background_background": "classic",
        "background_color": "#121525",
        "min_height": { "unit": "px", "size": 420 }
      },
      "elements": [
        {
          "id": "contact-hero-heading",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "PREMIUM GLOBAL EXPEDITIONS",
            "header_size": "h1"
          }
        }
      ]
    },
    {
      "id": "contact-intro-container",
      "elType": "container",
      "isInner": false,
      "settings": {
        "background_background": "classic",
        "background_color": "#F7F4ED",
        "padding": { "unit": "px", "top": "60", "right": "0", "bottom": "40", "left": "0" }
      },
      "elements": [
        {
          "id": "contact-intro-heading",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Get In Touch!",
            "header_size": "h2"
          }
        }
      ]
    },
    {
      "id": "contact-main-form-container",
      "elType": "container",
      "isInner": false,
      "settings": {
        "background_background": "classic",
        "background_color": "#F7F4ED",
        "flex_direction": "row"
      },
      "elements": [
        {
          "id": "contact-form-col",
          "elType": "container",
          "isInner": true,
          "settings": { "width": { "unit": "%", "size": 60 } },
          "elements": [
            {
              "id": "contact-elementor-form",
              "elType": "widget",
              "widgetType": "form",
              "settings": {
                "form_name": "PGE Contact Form",
                "form_fields": [
                  { "field_type": "text", "field_label": "Full Name", "placeholder": "Enter your full name", "required": "true" },
                  { "field_type": "email", "field_label": "Email Address", "placeholder": "Enter your email address", "required": "true" },
                  { "field_type": "tel", "field_label": "Phone Number", "placeholder": "Enter your phone number", "required": "true" },
                  {
                    "field_type": "select",
                    "field_label": "Subject",
                    "select_options": "General Inquiry\nFlights\nHotels & Accommodation\nCruises\nHoliday Packages\nTours & Experiences\nCar Rentals\nExisting Booking\nOther",
                    "required": "true"
                  },
                  { "field_type": "textarea", "field_label": "Message", "placeholder": "How can we help you?", "required": "true" }
                ],
                "button_text": "Send Message"
              }
            }
          ]
        },
        {
          "id": "contact-sidebar-col",
          "elType": "container",
          "isInner": true,
          "settings": {
            "width": { "unit": "%", "size": 40 },
            "background_background": "classic",
            "background_color": "#252E47"
          },
          "elements": [
            {
              "id": "concierge-info-box",
              "elType": "widget",
              "widgetType": "html",
              "settings": {
                "html": "<h3>Canadian Travel Concierge</h3><p>Email: hello@premiumglobalexp.ca</p><p>Location: Toronto, ON, Canada</p>"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "contact-cta-container",
      "elType": "container",
      "isInner": false,
      "settings": {
        "background_background": "classic",
        "background_color": "#252E47",
        "padding": { "unit": "px", "top": "80", "right": "0", "bottom": "80", "left": "0" }
      },
      "elements": [
        {
          "id": "cta-heading-widget",
          "elType": "widget",
          "widgetType": "heading",
          "settings": {
            "title": "Let's Plan Your Next Journey",
            "header_size": "h2"
          }
        }
      ]
    }
  ]
}
