{
  "version": "0.4",
  "title": "PGE Explore Package Detail Template",
  "type": "page",
  "page_settings": {},
  "content": [
    {
      "id": "pkg_hero_sec",
      "elType": "container",
      "isInner": false,
      "settings": {
        "_css_classes": "pkg-detail-hero",
        "container_type": "flex",
        "content_width": "full"
      },
      "elements": [
        {
          "id": "pkg_hero_container",
          "elType": "container",
          "isInner": true,
          "settings": {
            "_css_classes": "container"
          },
          "elements": [
            {
              "id": "pkg_hero_tagline",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "_css_classes": "section-tagline",
                "title": "Canada — Canadian Rockies & Luxury Express Rail",
                "header_size": "h5"
              }
            },
            {
              "id": "pkg_hero_title",
              "elType": "widget",
              "widgetType": "heading",
              "settings": {
                "_css_classes": "pkg-detail-title",
                "title": "Rocky Mountaineer Luxury Express",
                "header_size": "h1"
              }
            }
          ]
        }
      ]
    },
    {
      "id": "pkg_summary_sec",
      "elType": "container",
      "isInner": false,
      "settings": {
        "_css_classes": "pkg-summary-bar",
        "container_type": "flex",
        "content_width": "full"
      },
      "elements": [
        {
          "id": "pkg_summary_grid",
          "elType": "container",
          "isInner": true,
          "settings": {
            "_css_classes": "container summary-items-grid"
          },
          "elements": [
            {
              "id": "stat_duration",
              "elType": "widget",
              "widgetType": "counter",
              "settings": {
                "title": "Duration",
                "number": 8,
                "suffix": " Days / 7 Nights"
              }
            },
            {
              "id": "stat_rating",
              "elType": "widget",
              "widgetType": "counter",
              "settings": {
                "title": "Travel Standard",
                "number": 5,
                "suffix": " Star GoldLeaf"
              }
            }
          ]
        }
      ]
    }
  ]
}
